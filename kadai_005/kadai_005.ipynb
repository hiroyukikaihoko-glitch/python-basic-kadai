      "source": [
        "# 台形の寸法を定義\n",
        "upper_base = 10  # 上辺 (cm)\n",
        "lower_base = 20  # 下辺 (cm)\n",
        "height = 5       # 高さ (cm)\n",
        "\n",
        "# 公式:（上辺 ＋ 下辺）× 高さ ÷ 2\n",
        "area = (upper_base + lower_base) * height / 2\n",
        "\n",
        "# 結果の出力\n",
        "print(f\"台形の面積は {area} cm² です。\")"
      ]
    }
  ]
