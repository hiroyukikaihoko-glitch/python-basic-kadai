      "source": [
        "def calculate_consumptiontax(price: float, tax_rate: float) -> float:\n",
        "    # 消費税額を計算し、元の金額に加算します\n",
        "    return price * (1 + tax_rate / 100)\n",
        "\n",
        "# 指定された引数（金額: 110, 税率: 10%）を設定して実行\n",
        "result = calculate_consumptiontax(110, 10)\n",
        "print(result)"
      ]
    }
  ]
